+    if (event.type != SDL_EVENT_GAMEPAD_BUTTON_DOWN &&
+        event.type != SDL_EVENT_GAMEPAD_BUTTON_UP) return false;
+    const bool pressed = event.type == SDL_EVENT_GAMEPAD_BUTTON_DOWN;
+    const auto button = event.gbutton.button;
+    if (button == SDL_GAMEPAD_BUTTON_GUIDE) {
+        if (pressed) Overlay::TogglePortMenu();
+        return true;
+    }
+    if (button == SDL_GAMEPAD_BUTTON_START) nba16_start_down = pressed;
+    if (button == SDL_GAMEPAD_BUTTON_BACK) nba16_select_down = pressed;
+    if (nba16_start_down && nba16_select_down) {
+        if (nba16_menu_combo_started == 0) nba16_menu_combo_started = SDL_GetTicks();
+    } else {
+        nba16_menu_combo_started = 0;
+        nba16_menu_combo_fired = false;
+    }
+    return false;
+}
+
+void CheckNBA16MenuCombo() {
+    if (nba16_start_down && nba16_select_down && !nba16_menu_combo_fired &&
+        nba16_menu_combo_started != 0 && SDL_GetTicks() - nba16_menu_combo_started >= 2000) {
+        nba16_menu_combo_fired = true;
+        Overlay::TogglePortMenu();
+    }
+}
+} // namespace
