-    /*     A0            A1            A2            A3      */
-    {{        1.0f,         1.0f,         1.0f,         1.0f }}, /* W */
-    {{ EncodeCoeff,  EncodeCoeff, -EncodeCoeff, -EncodeCoeff }}, /* Y */
-    {{ EncodeCoeff, -EncodeCoeff, -EncodeCoeff,  EncodeCoeff }}, /* Z */
