-auto alIsSource_(gsl::not_null<al::Context*> context, ALuint source) noexcept -> ALboolean
-{
-    auto srclock = std::lock_guard{context->mSourceLock};
-    if(LookupSource(std::nothrow, context, source) != nullptr)
-        return AL_TRUE;
-    return AL_FALSE;
-}
