-                "  Depth: {:f}\n"
-                "  Feedback: {:f}\n"
-                "  Delay: {:f}", al::to_underlying(al_props_.Waveform), al_props_.Phase,
-                al_props_.Rate, al_props_.Depth, al_props_.Feedback, al_props_.Delay);
-        }
-
-        return true;
-    }
