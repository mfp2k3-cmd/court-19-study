-[[nodiscard]]
-auto LookupSource(std::nothrow_t, gsl::not_null<al::Context*> const context, ALuint const id)
-    noexcept -> al::Source*
-{
-    const auto lidx = (id-1) >> 6;
-    const auto slidx = (id-1) & 0x3f;
