-    laf->mSampleRate = std::invoke([input=std::span{footer}.first<4>()]
-    {
-        return u32{as_unsigned(input[0])} | (u32{as_unsigned(input[1])}<<8)
-            | (u32{as_unsigned(input[2])}<<16) | (u32{as_unsigned(input[3])}<<24);
-    });
