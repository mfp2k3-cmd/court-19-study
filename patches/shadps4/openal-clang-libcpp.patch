-            }
-        }
-        else if(command == "/end")
-        {
-            const auto endpos = gsl::narrow_cast<std::size_t>(istr.tellg());
-            if(!is_at_end(buffer, endpos))
-                return make_error(linenum, "Extra junk on end: {}",
-                    std::string_view{buffer}.substr(endpos));
