-
-    TRACE("Pre-reset: {}{}, {}{}, {}{}hz, {} / {} buffer",
-        device->mFlags.test(DeviceFlag::ChannelsRequest) ? "*" : "",
-        DevFmtChannelsString(device->FmtChans),
-        device->mFlags.test(DeviceFlag::SampleTypeRequest) ? "*" : "",
-        DevFmtTypeString(device->FmtType),
