-    if(!mCore)
-        throw al::backend_exception{al::backend_error::DeviceError,
-            "Failed to connect PipeWire event context (errno: {})\n", errno};
-    mlock.unlock();
-
-    /* TODO: Ensure the target ID is still valid/usable and accepts streams. */
