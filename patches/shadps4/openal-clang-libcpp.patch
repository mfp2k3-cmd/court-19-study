-SourceSubList::~SourceSubList()
-{
-    if(!mSources)
-        return;
-
-    auto usemask = ~mFreeMask;
-    while(usemask != 0)
-    {
-        const auto idx = usemask.countr_zero();
-        usemask &= ~(1_u64 << idx);
-        std::destroy_at(std::to_address(mSources->begin() + as_signed(idx.c_val)));
-    }
-    mFreeMask = ~usemask;
-    SubListAllocator{}.deallocate(mSources, 1);
-    mSources = nullptr;
-}
