-void WasapiPlayback::stop()
-{
-    auto plock = std::unique_lock{mProcMutex};
-    if(mState == ThreadState::Playing)
-    {
-        mKillNow = true;
-        mProcCond.wait(plock, [this]() noexcept { return mState != ThreadState::Playing; });
-    }
-}
