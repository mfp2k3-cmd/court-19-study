-    nfc.mBaseGain = 1.0f / g_1;
-    nfc.mCoeffs.a1 = (2.0f*b_10 + 4.0f*b_11) / g_1;
-    nfc.mCoeffs.a2 = 4.0f * b_11 / g_1;
-
-    nfc.mCoeffs.a0 = 1.0f;
-    nfc.mCoeffs.b1 = nfc.mCoeffs.a1;
-    nfc.mCoeffs.b2 = nfc.mCoeffs.a2;
