-    else if(num_decoded < num_files)
-        fmt::println(std::cerr, "Decoded {} of {} files", num_decoded, num_files);
-    else
-        fmt::println("Decoded {} file{}", num_decoded, (num_decoded==1)?"":"s");
-    return 0;
-}
