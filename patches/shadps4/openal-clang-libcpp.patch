-    auto &sublist = context->mSourceList[lidx];
-    if((sublist.mFreeMask & (1_u64 << slidx)) != 0) [[unlikely]]
-        return nullptr;
-    return std::to_address(sublist.mSources->begin() + as_signed(slidx));
