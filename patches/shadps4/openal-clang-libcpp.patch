-    nfc->mCoeffs.b3 = 2.0f * b_00 / g_0;
-}
-
-
-auto NfcFilterCreate4(float const w1) noexcept NONBLOCKING -> NfcFilter4
-{
-    auto nfc = NfcFilter4{};
-
-    auto const r = 0.5f * w1;
-    auto const b_10 = B4[0] * r;
