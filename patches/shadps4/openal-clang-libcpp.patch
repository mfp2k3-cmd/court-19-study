-    if (count == 0 && (a == end() || a->empty())) {
-        return path(".");
-    }
-    if (count < 0) {
-        return path();
-    }
-    path result;
-    for (int i = 0; i < count; ++i) {
-        result /= "..";
-    }
-    for (const auto& element : input_iterator_range<const_iterator>(a, end())) {
