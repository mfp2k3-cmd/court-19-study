-void PipeWirePlayback::ioChangedCallback(uint32_t const id, void *const area, uint32_t const size)
-    noexcept
-{
-    switch(id)
-    {
-    case SPA_IO_RateMatch:
-        if(size >= sizeof(spa_io_rate_match))
