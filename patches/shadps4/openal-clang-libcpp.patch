-    mRing = RingBuffer<std::byte>::Create(buffer_len, mDevice->frameSizeFromFmt(), false);
-
-    hr = client->SetEventHandle(mNotifyEvent);
-    if(FAILED(hr))
-    {
-        ERR("Failed to set event handle: {:#x}", as_unsigned(hr));
-        return hr;
-    }
-
-    return hr;
-}
