-
-#elif defined(_MSC_VER) && defined(_M_IX86_FP) && _M_IX86_FP == 0
-
-    int i;
-    __asm fld f
-    __asm fistp i
-    return i;
-
-#elif (defined(__GNUC__) || defined(__clang__)) && (defined(__i386__) || defined(__x86_64__)) \
-    && !defined(__SSE_MATH__)
-
-    int i;
-    __asm__ __volatile__("fistpl %0" : "=m"(i) : "t"(f) : "st");
