-    }
-
-    if(err != 0) [[unlikely]]
-    {
-        ERR("Failed to get stream latency: {:#x}", as_unsigned(err));
-        latency = 0;
-        neg = 0;
-    }
-    else if(neg) [[unlikely]]
-        latency = 0;
-    ret.Latency = std::chrono::microseconds{latency};
-
-    return ret;
