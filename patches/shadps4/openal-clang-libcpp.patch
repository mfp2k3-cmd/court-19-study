-    }
-
-    TRACE("Opening device \"{}\"", driver);
-    if(const auto err = snd_pcm_open(&mPcmHandle, driver.c_str(), SND_PCM_STREAM_CAPTURE,
-        SND_PCM_NONBLOCK); err < 0)
