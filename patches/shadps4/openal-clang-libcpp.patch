-WasapiPlayback::~WasapiPlayback()
-{
-    if(mProcThread.joinable())
-    {
-        {
-            auto plock = std::lock_guard{mProcMutex};
-            mKillNow = true;
-            mAction = ThreadAction::Quit;
-        }
-        mProcCond.notify_all();
-        mProcThread.join();
-    }
-
-    if(mNotifyEvent != nullptr)
-        CloseHandle(mNotifyEvent);
