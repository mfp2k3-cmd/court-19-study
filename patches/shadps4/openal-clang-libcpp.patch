-    }
-
-    auto buffer_len = UINT32{};
-    auto min_per = ReferenceTime{};
-    auto min_per_val = REFERENCE_TIME{};
-    hr = client->GetDevicePeriod(&min_per_val, nullptr);
-    if(SUCCEEDED(hr))
