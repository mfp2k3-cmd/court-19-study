-bool SetRTPriorityPthread(int prio [[maybe_unused]])
-{
-    auto err = ENOTSUP;
-#if defined(HAVE_PTHREAD_SETSCHEDPARAM) && !defined(__OpenBSD__)
-    /* Get the min and max priority for SCHED_RR. Limit the max priority to
