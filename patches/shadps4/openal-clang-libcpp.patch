-                mCounter = 0;
-                mCoeffs = mTargetCoeffs;
-                other.mCounter = 0;
-                other.mCoeffs = other.mTargetCoeffs;
-                break;
-            }
-
-            auto const a = 1.0f / static_cast<float>(counter+1);
-            mCoeffs.mB0 = lerpf(mCoeffs.mB0, mTargetCoeffs.mB0, a);
-            mCoeffs.mB1 = lerpf(mCoeffs.mB1, mTargetCoeffs.mB1, a);
