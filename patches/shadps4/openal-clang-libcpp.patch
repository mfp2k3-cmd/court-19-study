-            return;
-        }
-        break;
-
-    case SourceProp::SampleOffsetLatencySOFT:
-        if constexpr(std::is_same_v<T, ALint64SOFT>)
-        {
-            CheckSize(2);
-            /* Get the source offset with the clock time first. Then get the
