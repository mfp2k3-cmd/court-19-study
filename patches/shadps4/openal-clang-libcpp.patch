-
-        mNumChannels = gsl::narrow_cast<unsigned>(have.channels);
-        mFrameSize = mDevice->bytesFromFmt() * mNumChannels;
-
-        if(update_size >= 64)
-        {
-            /* We have to assume the total buffer size is just twice the update
