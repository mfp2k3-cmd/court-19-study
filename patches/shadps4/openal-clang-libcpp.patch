-void SDLCALL RenderSDLSamples(void *userdata, SDL_AudioStream *stream, int additional_amount,
-    int total_amount)
-{
-    PlaybackInfo *playback = (PlaybackInfo*)userdata;
-
-    if(additional_amount < 0)
-        additional_amount = total_amount;
-    if(additional_amount <= 0)
-        return;
