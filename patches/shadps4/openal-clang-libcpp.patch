-{
-    auto *delay_dim = gsl::czstring{};
-    auto const *delay_attrs = sofaHrtf->DataDelay.attributes;
-    while(delay_attrs)
-    {
-        if("DIMENSION_LIST"sv == delay_attrs->name)
-        {
-            if(delay_dim)
