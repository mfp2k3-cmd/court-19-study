-auto SDL3BackendFactory::init() -> bool
-{
-    if(!SDL_InitSubSystem(SDL_INIT_AUDIO))
-        return false;
-    TRACE("Current SDL3 audio driver: \"{}\"", SDL_GetCurrentAudioDriver());
-
-    if(not SDL_AddEventWatch(&EventHandler, nullptr))
