-     */
-    palDebugMessageInsertEXT(AL_DEBUG_SOURCE_APPLICATION_EXT, AL_DEBUG_TYPE_MARKER_EXT, 0,
-        AL_DEBUG_SEVERITY_NOTIFICATION_EXT, -1, "End of run, cleaning up");
-    palDebugMessageCallbackEXT(nullptr, nullptr);
-
-    return 0;
-}
-
-} // namespace
