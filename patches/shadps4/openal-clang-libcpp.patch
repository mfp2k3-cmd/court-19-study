-            preamble = f'{external_headers}\n{other_headers}\n#ifdef __cplusplus\nextern "C" {{\n#endif'.strip()
-            f.write(
-                STANDARD_HEADER_TEMPLATE.format(
-                    guard=f"AL_{os.path.basename(annex_header).upper().replace('.', '_')}",
-                    preamble=preamble,
-                    content="\n".join(
-                        render_set(
