-        if(!(state&DEVICE_STATE_ACTIVE))
-            return S_OK;
-
-        auto endpoint = ComPtr<IMMEndpoint>{};
-        hr = device->QueryInterface(__uuidof(IMMEndpoint), al::out_ptr(endpoint));
-        if(FAILED(hr))
-        {
-            ERR("Failed to get device endpoint: {:#x}", as_unsigned(hr));
-            return S_OK;
