-    const auto id = buffer->mId - 1;
-    const auto lidx = id >> 6;
-    const auto slidx = id & 0x3f;
-
-    std::destroy_at(buffer.get());
-
-    device->BufferList[lidx].mFreeMask |= 1_u64 << slidx;
-}
