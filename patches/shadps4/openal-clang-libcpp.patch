-void pffft_zconvolve_scale_accumulate_internal(const PFFFT_Setup *s, const v4sf *RESTRICT va,
-    const v4sf *RESTRICT vb, v4sf *RESTRICT vab, float scaling)
-{
-    const auto Ncvec = size_t{s->Ncvec};
-
-#ifdef __arm__
-    __builtin_prefetch(va);
