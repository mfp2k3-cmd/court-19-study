-FMT_CONSTEXPR auto format_base2e(int base_bits, Char* out, UInt value,
-                                 int num_digits, bool upper = false) -> Char* {
-  do_format_base2e(base_bits, out, value, num_digits, upper);
-  return out + num_digits;
