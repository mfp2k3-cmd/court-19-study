-    void start() override;
-    void stop() override;
-
-    std::ofstream mFile;
-    std::streamoff mDataStart{-1};
-
-    std::vector<char> mBuffer;
-    bool mCAFOutput{};
-
-    std::atomic<bool> mKillNow{true};
-    std::thread mThread;
-};
