-auto OSSBackendFactory::init() -> bool
-{
-    if(auto devopt = ConfigValueStr({}, "oss", "device"))
-        DefaultPlayback = std::move(*devopt);
-    if(auto capopt = ConfigValueStr({}, "oss", "capture"))
-        DefaultCapture = std::move(*capopt);
