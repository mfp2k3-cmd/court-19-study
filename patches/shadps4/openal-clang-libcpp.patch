-        PlaybackDevices.clear();
-        if(const auto hr = DirectSoundEnumerateW(DSoundEnumDevices, &PlaybackDevices); FAILED(hr))
-            ERR("Error enumerating DirectSound playback devices: {:#x}", as_unsigned(hr));
