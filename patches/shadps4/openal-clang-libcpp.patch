-{
-    if constexpr(std::is_signed_v<T> && num_bits < sizeof(T)*8)
-    {
-        constexpr auto signbit = gsl::narrow_cast<T>(1u << (num_bits-1));
-        return gsl::narrow_cast<T>((value^signbit) - signbit);
