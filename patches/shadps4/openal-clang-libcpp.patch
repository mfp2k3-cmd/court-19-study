-    case 4:
-        eax4_context_commit(mEax4, dst_df);
-        break;
-    case 5:
-        eax5_context_commit(mEax5, dst_df);
-        break;
-    }
-
-    if(dst_df.none())
-        return;
-
-    if(dst_df.test(eax_primary_fx_slot_id_dirty_bit))
-        eax_context_commit_primary_fx_slot_id();
