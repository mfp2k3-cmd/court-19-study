-constexpr auto GetAmbiLayout(DevAmbiLayout const layouttype) noexcept
-{
-    switch(layouttype)
-    {
-        case DevAmbiLayout::FuMa: return std::span{AmbiIndex::FromFuMa};
-        case DevAmbiLayout::ACN: break;
-    }
-    return std::span{AmbiIndex::FromACN};
-}
