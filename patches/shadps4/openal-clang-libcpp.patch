-    std::ranges::for_each(mPipelines, [splitter](ReverbPipeline &pipeline)
-    {
-        pipeline.mAmbiSplitter[0].fill(splitter);
-        pipeline.mAmbiSplitter[1].fill(splitter);
-    });
