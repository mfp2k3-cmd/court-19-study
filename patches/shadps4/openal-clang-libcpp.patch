-auto JackBackendFactory::createBackend(gsl::not_null<DeviceBase*> device, BackendType type)
-    -> BackendPtr
-{
-    if(type == BackendType::Playback)
-        return BackendPtr{new JackPlayback{device}};
-    return nullptr;
-}
