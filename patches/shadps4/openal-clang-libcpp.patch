-        effect->mPropsVariant.emplace<DedicatedLfeEffectHandler>();
-        break;
-    case AL_EFFECT_CONVOLUTION_SOFT:
-        effect->mPropsVariant.emplace<ConvolutionEffectHandler>();
-        break;
-    }
-    effect->mProps = GetDefaultProps(type);
-    effect->mType = type;
