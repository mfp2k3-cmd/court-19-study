-    case DevFmtUByte:
-        clearval = char{-0x80};
-        [[fallthrough]];
-    case DevFmtShort:
-    case DevFmtInt:
-    case DevFmtFloat:
-        break;
-
-    case DevFmtByte:
-    case DevFmtUShort:
