-    auto chanmap = pa_channel_map{};
-    switch(mDevice->FmtChans)
-    {
-    case DevFmtMono:
-        chanmap = MonoChanMap;
-        break;
-    case DevFmtAmbi3D:
-        mDevice->FmtChans = DevFmtStereo;
-        [[fallthrough]];
-    case DevFmtStereo:
-        chanmap = StereoChanMap;
-        break;
-    case DevFmtQuad:
-        chanmap = QuadChanMap;
-        break;
-    case DevFmtX51:
-        chanmap = (mIs51Rear ? X51RearChanMap : X51ChanMap);
-        break;
-    case DevFmtX61:
-        chanmap = X61ChanMap;
-        break;
-    case DevFmtX71:
-    case DevFmtX3D71:
-        chanmap = X71ChanMap;
-        break;
-    case DevFmtX7144:
-        mDevice->FmtChans = DevFmtX714;
-        [[fallthrough]];
-    case DevFmtX714:
-        chanmap = X714ChanMap;
-        break;
-    }
-    setDefaultWFXChannelOrder();
-
-    switch(mDevice->FmtType)
-    {
-    case DevFmtByte:
-        mDevice->FmtType = DevFmtUByte;
-        [[fallthrough]];
-    case DevFmtUByte:
-        mSpec.format = PA_SAMPLE_U8;
-        break;
-    case DevFmtUShort:
-        mDevice->FmtType = DevFmtShort;
-        [[fallthrough]];
-    case DevFmtShort:
-        mSpec.format = PA_SAMPLE_S16NE;
-        break;
-    case DevFmtUInt:
-        mDevice->FmtType = DevFmtInt;
-        [[fallthrough]];
-    case DevFmtInt:
-        mSpec.format = PA_SAMPLE_S32NE;
-        break;
-    case DevFmtFloat:
-        mSpec.format = PA_SAMPLE_FLOAT32NE;
-        break;
