-                continue;
-            }
-            else if (*(--dest.end()) != "..") {
-                if (dest._path.back() == preferred_separator) {
-                    dest._path.pop_back();
-                }
-                dest.remove_filename();
-                continue;
-            }
-        }
-        if (!(s.empty() && lastDotDot)) {
-            dest /= s;
-        }
-        lastDotDot = s == "..";
-    }
-    if (dest.empty()) {
-        dest = ".";
-    }
-    return dest;
