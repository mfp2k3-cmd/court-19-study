-        // Calculate the phase index and factor.
-        auto const pi = frac >> BSincPhaseDiffBits; ASSUME(pi < BSincPhaseCount);
-        auto const pf = static_cast<float>(frac&BSincPhaseDiffMask)*float{1.0f/BSincPhaseDiffOne};
