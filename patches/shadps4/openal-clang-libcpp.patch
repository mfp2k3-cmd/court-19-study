-  void on_duration_value() {
-    if (handle_nan_inf()) return;
-    write_sign();
-    out = format_duration_value<Char>(out, val, precision);
-  }
-
-  void on_duration_unit() { out = format_duration_unit<Char, Period>(out); }
-};
