-#if ALSOFT_EAX
-    eax_x_ram_clear(*context->mALDevice, *ALBuf);
-#endif
-
-    ALBuf->mBlockAlign = (DstType == FmtIMA4 || DstType == FmtMSADPCM) ? samplesPerBlock : 1u;
