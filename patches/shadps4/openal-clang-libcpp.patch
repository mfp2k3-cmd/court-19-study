-constexpr auto GetByteOrderEndianness() noexcept -> SLuint32
-{
-    if constexpr(std::endian::native == std::endian::little)
-        return SL_BYTEORDER_LITTLEENDIAN;
-    return SL_BYTEORDER_BIGENDIAN;
-}
