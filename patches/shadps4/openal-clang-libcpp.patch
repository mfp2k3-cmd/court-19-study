-                        hData->mIrSize);
-                }
-            }
-        }
-    }
-    if(!TrLoad(tr))
-    {
-        gSofaCache.clear();
-        return true;
-    }
-
-    TrError(tr, "Errant data at end of source list.");
-    gSofaCache.clear();
-    return false;
-}
