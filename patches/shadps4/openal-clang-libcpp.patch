-constexpr auto MaskFromTopBits(DWORD b) noexcept -> DWORD
-{
-    b |= b>>1;
-    b |= b>>2;
-    b |= b>>4;
-    b |= b>>8;
-    b |= b>>16;
-    return b;
-}
