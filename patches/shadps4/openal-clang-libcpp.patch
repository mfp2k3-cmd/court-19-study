-    case DevFmtShort: format = SND_PCM_FORMAT_S16; break;
-    case DevFmtUShort: format = SND_PCM_FORMAT_U16; break;
-    case DevFmtInt: format = SND_PCM_FORMAT_S32; break;
-    case DevFmtUInt: format = SND_PCM_FORMAT_U32; break;
