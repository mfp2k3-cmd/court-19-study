-static void printList(const char *list, char separator)
-{
-    size_t col = MaxWidth;
-    size_t len;
-    const char *indent = "    ";
-    const char *next;
-
-    if(!list || *list == '\0')
-    {
-        printf("\n%s!!! none !!!\n", indent);
-        return;
-    }
-
-    do {
-        next = strchr(list, separator);
-        if(next)
-        {
-            len = (size_t)(next-list);
-            do {
-                next++;
-            } while(*next == separator);
-        }
-        else
-            len = strlen(list);
-
-        if(len + col + 2 >= MaxWidth)
-        {
-            printf("\n%s", indent);
-            col = strlen(indent);
-        }
-        else
-        {
-            fputc(' ', stdout);
-            col++;
-        }
-
-        len = fwrite(list, 1, len, stdout);
-        col += len;
-
-        if(!next || *next == '\0')
-            break;
-        fputc(',', stdout);
-        col++;
-
-        list = next;
-    } while(1);
-    fputc('\n', stdout);
-}
